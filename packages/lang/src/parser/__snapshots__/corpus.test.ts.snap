exports[`parser corpus snapshots (LANG-06.1; interpreter-vm.md §Testing: AST snapshots of the corpus) > parses statements.sprout to its snapshot AST and diagnostics 1`] = `
"[1:1-40:1] file "statements.sprout"
  [2:1-2:10] (= count 0)
  [3:1-3:20] (= (index (index grid 2) 3) RADISH)
  [4:1-4:11] (+= count 1)
  [5:1-5:11] (-= count 1)
  [6:1-6:11] (*= count 2)
  [7:1-7:12] (//= count 2)
  [8:1-8:11] (%= count 7)
  [9:1-9:5] (pass)
  [11:1-19:15] def tend()
    [12:5-12:17] (global count)
    [13:5-18:13] if (call is_ripe)
      [14:9-14:18] (expr (call harvest))
    [15:5-16:22] elif (cmp (call crop) == None)
      [16:9-16:22] (expr (call plant RADISH))
    else
      [18:9-18:13] (pass)
    [19:5-19:15] (+= count 1)
  [21:1-26:17] def go(x, y)
    [22:5-23:19] repeat x
      [23:9-23:19] (expr (call move EAST))
    [24:5-25:20] for i in (call range y)
      [25:9-25:20] (expr (call move NORTH))
    [26:5-26:17] (return (+ x y))
  [28:1-34:11] def first_ripe(tiles)
    [29:5-33:21] for t in tiles
      [30:9-31:21] if (cmp t == None)
        [31:13-31:21] (continue)
      [32:9-33:21] if (cmp t > 3)
        [33:13-33:21] (return t)
    [34:5-34:11] (return)
  [36:1-39:14] while True
    [37:5-37:11] (expr (call tend))
    [38:5-39:14] if (cmp count > 100)
      [39:9-39:14] (break)
--- diagnostics ---"
`;

