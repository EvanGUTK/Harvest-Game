# Copy to .env for local development. Never commit real values.
# This file lists variable NAMES only; it is the single list of environment variables. Render env
# groups use these same names (docs/06-infrastructure/hosting.md).
# Accounts, DNS records, OAuth settings and GitHub Actions secrets (which are not env vars) are
# listed in docs/06-infrastructure/connections.md.

# Server runtime
NODE_ENV=development
APP_ENV=development      # development | preview | staging | production
PORT=3000                # local dev: Vite (:5173) proxies /api and /ws to this port
PUBLIC_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173   # Origin allowlist for mutating routes and the WebSocket upgrade

# Neon Postgres
DATABASE_URL=            # pooled connection string (app traffic)
DATABASE_URL_UNPOOLED=   # direct connection string (migrations, seeds); same value as DATABASE_URL for local Docker Postgres

# Better Auth
BETTER_AUTH_SECRET=      # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Code Harvest <login@mail.example.com>"

# Test sign-in (development, preview and staging only; the server refuses to boot with it set in production)
AUTH_TEST_OTP_SECRET=

# Observability
SENTRY_DSN=              # server project DSN (runtime)
METRICS_TOKEN=           # bearer token for /metrics (optional locally)
# Build-time only (Render env group, build secrets; not needed locally):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT_WEB=
# SENTRY_PROJECT_SERVER=
# The release id is RENDER_GIT_COMMIT (set by Render); locally it falls back to `git rev-parse HEAD`.

# Preview service only (Render): resolve the per-PR Neon branch at boot
# NEON_API_KEY=
# NEON_PROJECT_ID=

# Tests (CI supplies these; set locally only to run the same tests by hand)
# DATABASE_URL_CI=       # direct URL of a scratch database for server integration tests

# Optional: Cloudflare Turnstile captcha (feature-flagged off; leave blank to keep it off)
# TURNSTILE_SECRET_KEY=

# Client build (apps/web). Vite compiles only VITE_*-prefixed variables into the browser bundle,
# so these are PUBLIC. Never put a secret here, and never give a server secret a VITE_ prefix.
# Leave the URL overrides empty for hosting option A (ADR-0004): the client uses relative /api and
# /ws, and the Vite dev server proxies both to PORT above.
VITE_API_URL=            # option B only: https://api.<domain>
VITE_WS_URL=             # option B only: wss://api.<domain>/ws
VITE_SENTRY_DSN=         # web project DSN (separate from the server SENTRY_DSN)
# VITE_PLAUSIBLE_DOMAIN= # play.<domain>; set only when cookieless analytics is enabled (observability.md)
# VITE_TURNSTILE_SITE_KEY= # only if Turnstile is enabled (security-anti-cheat.md)
