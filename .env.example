# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=8080
PUBLIC_URL=http://localhost:8080

# Neon Postgres
DATABASE_URL=            # pooled connection string (app traffic)
DATABASE_URL_DIRECT=     # direct connection string (migrations)

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend
RESEND_API_KEY=
EMAIL_FROM="Code Harvest <login@mail.example.com>"

# Observability
SENTRY_DSN=
