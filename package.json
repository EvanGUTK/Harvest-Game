{
  "name": "code-harvest",
  "private": true,
  "description": "Program a farm drone in Sprout, a Python-style language. Single-player campaign + multiplayer coding showdowns.",
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --testTimeout=30000",
    "test:watch": "vitest --testTimeout=30000",
    "sprout": "pnpm --filter @harvest/tool-run start",
    "balance": "pnpm --filter @harvest/tool-balance start"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "fast-check": "^3.23.2",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
